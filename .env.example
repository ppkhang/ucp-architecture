POSTGRES_USER=ucp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ucp
DATABASE_URL=postgresql://ucp:change-me@127.0.0.1:5432/ucp
REDIS_URL=redis://localhost:6379/0
MOCK_MODE=always_succeed
MOCK_BASE_URL=http://localhost:9000
MOCK_WEBHOOK_URL=
MOCK_WEBHOOK_SECRET=change-me
# UCP identity (step 4). Generate real values:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"            -> JWT_SECRET
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  -> TOKEN_KEY
# Unset = random key per process (local dev only; with TOKEN_KEY unset, linked accounts break on restart).
# Compose requires real values.
# JWT_SECRET=
# TOKEN_KEY=
PUBLIC_URL=http://localhost:8000
MOCK_CLIENT_ID=ucp
MOCK_CLIENT_SECRET=ucp-mock-secret
# Background workers (expiry, order sync, outbox relay): seconds between runs, 0 = off
WORKERS_INTERVAL_SECONDS=0
# BR-26: open checkouts per shop user, and the wait after several expiries in a row
# MAX_OPEN_CHECKOUTS=3
# CHECKOUT_COOLDOWN_AFTER=3
# CHECKOUT_COOLDOWN_SECONDS=600
# Event stream: poll interval and the longest a stream stays open, in seconds
# SSE_POLL_SECONDS=1
# SSE_MAX_SECONDS=300
SYNC_MIN_AGE_SECONDS=30
# MCP server (step 10). Make the key with: python -m mcp_server register
# UCP_API_URL=http://127.0.0.1:8000
# UCP_API_KEY=
# MCP_PORT=8765
# HTTP transport only: the tunnel's https address, and a password of 12+ characters for the OAuth sign-in page
# MCP_PUBLIC_URL=
# MCP_OWNER_PASSWORD=
